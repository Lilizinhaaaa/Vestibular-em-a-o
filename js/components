import { h } from "../utils.js";

export function emptyState({ icon = "🚧", title, text, actionLabel, actionHref }) {
  return h("div", { class: "empty-state" },
    h("div", { class: "empty-state__icon", "aria-hidden": "true" }, icon),
    h("h2", {}, title),
    h("p", {}, text),
    actionLabel ? h("a", { class: "btn btn--primary", href: actionHref }, actionLabel) : null
  );
}
