function burstSvg() {
  const ns = "http://www.w3.org/2000/svg";
  const svg = document.createElementNS(ns, "svg");
  svg.setAttribute("viewBox", "0 0 100 100");
  svg.setAttribute("class", "hero__burst");
  svg.setAttribute("aria-hidden", "true");
  let pts = "";
  for (let i = 0; i < 24; i++) {
    const r = i % 2 === 0 ? 48 : 34;
    const a = (Math.PI * 2 * i) / 24 - Math.PI / 2;
    pts += `${(50 + r * Math.cos(a)).toFixed(1)},${(50 + r * Math.sin(a)).toFixed(1)} `;
  }
  const poly = document.createElementNS(ns, "polygon");
  poly.setAttribute("points", pts.trim());
  poly.setAttribute("fill", "#FFD45C");
  poly.setAttribute("stroke", "#24212B");
  poly.setAttribute("stroke-width", "2");
  poly.setAttribute("stroke-linejoin", "round");
  const circle = document.createElementNS(ns, "circle");
  circle.setAttribute("cx", "50"); circle.setAttribute("cy", "50"); circle.setAttribute("r", "26");
  circle.setAttribute("fill", "#F36C9B"); circle.setAttribute("stroke", "#24212B"); circle.setAttribute("stroke-width", "2");
  svg.append(poly, circle);
  return svg;
}

